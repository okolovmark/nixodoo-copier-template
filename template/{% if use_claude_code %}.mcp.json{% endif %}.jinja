{
  "mcpServers": {
    "odoo": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "source .env && uvx --from 'git+https://github.com/okolovmark/odoo-fast-mcp' odoo-fast-mcp"
      ]
    },
    "postgres-mcp": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "source .env && uvx --with 'mcp<2' postgres-mcp --access-mode=unrestricted $DATABASE_URI"
      ]
    },
    "mcp-pdb": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "mcp-pdb==0.4.0",
        "--with",
        "mcp<2",
        "mcp-pdb"
      ]
    }{% if status_mcp == 'teams' %},
    "teams": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "git+https://github.com/okolovmark/teams-mcp.git#stable"
      ]
    }{% endif %}
  }
}
