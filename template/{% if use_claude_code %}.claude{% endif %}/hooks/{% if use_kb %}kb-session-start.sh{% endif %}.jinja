#!/usr/bin/env bash
# SessionStart hook: the kb memory index and today's standup go into the session context.
# stdout is context for Claude, not shown to the user. Silent when kb is not installed,
# so teammates without kb see nothing. Never exits non-zero: a session must always start.
set -u
command -v kb >/dev/null 2>&1 || exit 0

INPUT=$(cat)
read -r SESSION_ID SOURCE < <(printf '%s' "$INPUT" | python3 -c \
    'import json,sys; d=json.load(sys.stdin); print(d.get("session_id",""), d.get("source",""))')
export KB_SESSION="$SESSION_ID"
SCOPE="{{ project_name }}"

status=$(kb --json status 2>/dev/null || true)
reachable=$(printf '%s' "$status" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("bolt_reachable", False))' 2>/dev/null || echo False)
if [ "$reachable" != "True" ]; then
    echo "kb: neo4j-kb.service was not answering at session start; starting it (up to start_timeout)."
    if ! kb service start >/dev/null 2>&1; then
        echo "kb: NO MEMORY. Neo4j did not come up. Tell the user before anything else; then: kb status; journalctl --user -u neo4j-kb.service -n 100"
        exit 0
    fi
fi
upgrade=$(printf '%s' "$status" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("upgrade_pending", False))' 2>/dev/null || echo False)
[ "$upgrade" = "True" ] && echo "kb: the unit runs an older neo4j than the installed package; run kb-setup."

# Optional Odoo pull ([sources.odoo] enabled); prints only on failure, never fails.
kb sync odoo 2>&1 | sed 's/^/kb: /'

# The session skeleton; Claude writes the body at close (kb session close --body-file …).
kb session open --scope "$SCOPE" --id "$SESSION_ID" --source "$SOURCE" 2>&1 | sed "s/^/kb: session /"
kb index --scope "$SCOPE"
echo
kb today --scope "$SCOPE" --record-shown

# Project-owned extras (not templated): entire fan-out check, stray files, anything local.
# Contract: $1 = the SessionStart source, $2 = this session's id (also exported as
# KB_SESSION). A local check that needs the live session MUST use that id and must never
# ask a tool for "the current session": the other SessionStart hooks run in PARALLEL with
# this one, so a tool answering from state on disk hands back the PREVIOUS session and the
# check then chases a stale id. That is a real bug, shipped twice - see kaertech-odoo-16
# PR #65 and kaertech-odoo-19 PR #3, where it cried "BROKEN fan-out" every single session.
LOCAL="$(dirname "$0")/kb-session-start.local.sh"
[ -x "$LOCAL" ] && bash "$LOCAL" "$SOURCE" "$SESSION_ID"
exit 0
