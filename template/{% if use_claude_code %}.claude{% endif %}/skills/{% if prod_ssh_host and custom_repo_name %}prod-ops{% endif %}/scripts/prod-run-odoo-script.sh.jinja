{% set prod_hosts = ['prod'] + (['prod-local'] if prod_local_ssh_host else []) %}
{% set hosts = prod_hosts + (test_ssh_hosts | list) %}
#!/usr/bin/env bash
# Run a LOCAL odoo-shell script on the prod/test box: pipes the named file into
# `odoo-bin shell` over SSH. The shell runs as SUPERUSER; the dry/commit
# discipline is the script contract (see the prod-ops skill), not a guard here.
#
# Usage: prod-run-odoo-script.sh <{{ hosts | join('|') }}> <script.py> [dry|commit]
#
# The script must read SCRIPT_MODE (default "dry"), only env.cr.commit() in
# commit mode, and end with: print("SCRIPT_DONE mode=%s" % MODE)
# This runner exits non-zero when that marker is missing, so a script that died
# mid-way cannot read as success.
set -euo pipefail

HOST="${1:-}"
SCRIPT="${2:-}"
MODE="${3:-dry}"

usage() { echo "usage: $0 <{{ hosts | join('|') }}> <script.py> [dry|commit]" >&2; exit 2; }

case "$HOST" in
  {{ hosts | join('|') }}) ;;
  *) usage ;;
esac
[ -n "$SCRIPT" ] && [ -f "$SCRIPT" ] || { echo "no such script: $SCRIPT" >&2; usage; }
case "$MODE" in dry|commit) ;; *) usage ;; esac

# Each box has its own database: prod's is {{ prod_db_name }}, a test box has its own.
# Odoo creates a database it cannot find and installs base into it, so a wrong
# name here does not fail: the command runs on a new empty database and exits 0.
case "$HOST" in
  {{ prod_hosts | join('|') }}) DB={{ prod_db_name }} ;;
{% for alias in test_ssh_hosts %}
  {{ alias }}) DB={{ test_db_name | replace('{alias}', alias) | replace('{short}', alias.split('.')[0]) }} ;;
{% endfor %}
esac

set +e
OUT=$(ssh -F "${{ project_dir_var }}/.ssh/config" "$HOST" \
  "export PATH=\"\$HOME/{{ nix_profile_rel }}/bin:\$PATH\"; SCRIPT_MODE=$MODE python {{ prod_remote_project_dir }}/src/odoo/odoo-bin shell -c {{ prod_remote_odoo_conf }} -d $DB --no-http" \
  < "$SCRIPT" 2>&1)
SSH_EXIT=$?
set -e

printf '%s\n' "$OUT"
if [ "$SSH_EXIT" -ne 0 ]; then
  echo "SHELL_EXIT=$SSH_EXIT" >&2
  exit "$SSH_EXIT"
fi
if ! printf '%s' "$OUT" | grep -q "SCRIPT_DONE mode=$MODE"; then
  echo "MARKER_MISSING: script did not print 'SCRIPT_DONE mode=$MODE'" >&2
  exit 1
fi
echo "RUN_OK host=$HOST mode=$MODE"
