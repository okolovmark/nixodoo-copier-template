{% set prod_hosts = ['prod'] + (['prod-local'] if prod_local_ssh_host else []) %}
{% set hosts = prod_hosts + (test_ssh_hosts | list) %}
#!/usr/bin/env bash
# Deploy merged addons work to the Odoo box: pull {{ odoo_version }}, update the named
# modules, restart the service (deploy skill Step 2, "order B" — the live
# service keeps serving during the update, so downtime is the restart only).
#
# Runs as ONE argv on purpose. The equivalent inline
# `ssh prod 'set -euo pipefail …'` is a multi-line remote script, and an
# auto-mode classifier judges it as such every single deploy; one named script
# with validated arguments is a single decision that can be authorized once.
#
# Usage: prod-deploy-modules.sh <{{ hosts | join('|') }}> <-u|-i> <modules> [--link-addons]
#   prod-deploy-modules.sh prod -u {{ module_prefix }}_sale
#   prod-deploy-modules.sh prod -i {{ module_prefix }}_new --link-addons
#
# --link-addons re-links the addon symlinks; pass it ONLY when a module was
# added or removed in the merged PR.
#
# Refuses to run unless the box's deploy lock is held (deploy skill Step 3.5,
# prod-deploy-lock.sh beside this file): DEPLOY_LOCK_MISSING, DEPLOY_EXIT=3,
# nothing pulled. The lock is what keeps two developers' deploys apart.
#
# Prints the full remote log, then DEPLOY_EXIT=<n>. Exits non-zero if the
# update failed, so a broken deploy cannot read as success.
set -euo pipefail

HOST="${1:?usage: prod-deploy-modules.sh <{{ hosts | join('|') }}> <-u|-i> <modules> [--link-addons]}"
FLAG="${2:?missing -u or -i}"
MODULES="${3:?missing module list}"
LINK="${4:-}"

case "$HOST" in {{ hosts | join('|') }}) ;; *) echo "refusing unknown host: $HOST" >&2; exit 2 ;; esac
case "$FLAG" in -u|-i) ;; *) echo "flag must be -u or -i, got: $FLAG" >&2; exit 2 ;; esac
[[ "$MODULES" =~ ^[a-z0-9_,]+$ ]] || { echo "module list must be comma-separated names: $MODULES" >&2; exit 2; }
case "$LINK" in ""|--link-addons) ;; *) echo "unknown 4th argument: $LINK" >&2; exit 2 ;; esac

# Each box has its own database: prod's is {{ prod_db_name }}, a test box has its own.
# Odoo creates a database it cannot find and installs base into it, so a wrong
# name here does not fail: the command runs on a new empty database and exits 0.
case "$HOST" in
  {{ prod_hosts | join('|') }}) DB={{ prod_db_name }} ;;
{% for alias in test_ssh_hosts %}
  {{ alias }}) DB={{ test_db_name | replace('{alias}', alias) | replace('{short}', alias.split('.')[0]) }} ;;
{% endfor %}
esac

PROJECT_DIR="${{ project_dir_var }}"
[ -n "$PROJECT_DIR" ] || PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
SSH_CONFIG="$PROJECT_DIR/.ssh/config"
[ -f "$SSH_CONFIG" ] || { echo "no ssh config at $SSH_CONFIG (run: nix run .#setup-ssh-access)" >&2; exit 2; }

link_step=""
[ "$LINK" = "--link-addons" ] && link_step='cd {{ prod_remote_project_dir }} && {{ prod_link_addons_cmd }}'

# -A: the box's `origin` is a git SSH remote and the pull runs on your
# forwarded key, not on a deploy key sitting in the box's ~/.ssh.
#
# --logfile= is empty on purpose: Odoo realpaths the option, so /dev/stdout
# becomes /proc/<pid>/fd/pipe:[N] over SSH and cannot be opened. Empty leaves it
# falsy, so Odoo keeps its default stderr handler and the log still comes back.
#
# --dev=xml on the update only: views are then validated against their files, as
# the local `odoo` wrapper always does. Without it a view the update has not
# reloaded yet is read from the database, and a field the new code removed fails
# on the box an update every local rehearsal passed. The restart runs without it.
set +e
ssh -A -F "$SSH_CONFIG" "$HOST" "set -euo pipefail
[ -d {{ prod_remote_project_dir }}/.deploy-lock ] || { echo 'DEPLOY_LOCK_MISSING: take the deploy lock first (prod-deploy-lock.sh <host> acquire <PR>)' >&2; exit 3; }
export PATH=\"\$HOME/{{ nix_profile_rel }}/bin:\$PATH\"
cd {{ prod_remote_project_dir }}/src/{{ custom_repo_name }}
git pull origin {{ odoo_version }}
$link_step
python {{ prod_remote_project_dir }}/src/odoo/odoo-bin -c {{ prod_remote_odoo_conf }} --workers 0 -d $DB $FLAG $MODULES --stop-after-init --dev=xml --logfile=
systemctl --user restart odoo{{ service_suffix }}.service"
status=$?
set -e

echo "DEPLOY_EXIT=$status"
exit "$status"
