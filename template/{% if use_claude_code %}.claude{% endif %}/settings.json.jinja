{
  "hooks": {
{% if use_kb or use_entire %}
    "SessionStart": [
{% if use_entire %}
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/entire-fanout.sh session-start"
          }
        ]
      }{% if use_kb %},{% endif +%}
{% endif %}
{% if use_kb %}
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/kb-session-start.sh",
            "timeout": 60
          }
        ]
      }
{% endif %}
    ],
    "SessionEnd": [
{% if use_entire %}
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/entire-fanout.sh session-end"
          }
        ]
      }{% if use_kb %},{% endif +%}
{% endif %}
{% if use_kb %}
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/kb-session-end.sh",
            "timeout": 10
          }
        ]
      }
{% endif %}
    ],
{% endif %}
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/guard-readonly.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/guard-bash.sh"
          },
          {
            "type": "command",
            "command": "python3 ${{ project_dir_var }}/.claude/hooks/nudge-find-code.py"
          }{% if use_kb %},
          {
            "type": "command",
            "command": "python3 ${{ project_dir_var }}/.claude/hooks/nudge-kb-truncation.py"
          }{% endif +%}
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${{ project_dir_var }}/.claude/hooks/nudge-find-code.py"
          }
        ]
      }{% if use_entire %},
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/entire-fanout.sh pre-task"
          }
        ]
      }{% endif +%}
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/ruff-post-edit.sh"
          }
        ]
      }{% if use_entire %},
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/entire-fanout.sh post-task"
          }
        ]
      },
      {
        "matcher": "TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/entire-fanout.sh post-todo"
          }
        ]
      }{% endif +%}
    ]{% if use_entire %},
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/entire-fanout.sh stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${{ project_dir_var }}/.claude/hooks/entire-fanout.sh user-prompt-submit"
          }
        ]
      }
    ]{% endif +%}
  },
{% if use_entire %}
  "permissions": {
    "deny": [
      "Read(./.entire/metadata/**)",
      "Read(./src/{{ custom_repo_name }}/.entire/metadata/**)"
    ]
  },
{% endif %}
  "statusLine": {
    "type": "command",
    "command": "bash ${{ project_dir_var }}/.claude/statusline-command.sh"
  }
}
