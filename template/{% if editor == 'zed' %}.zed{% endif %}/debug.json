[
  {
    "label": "Odoo: Debug Server",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/src/odoo/odoo-bin",
    "args": [
      "--config=$ZED_WORKTREE_ROOT/odoo.conf",
      // No `reload`: the reloader re-execs the process and the debugger loses it
      // ("process exited before debugger attached").
      "--dev=qweb,werkzeug,xml",
      "--workers=0",
      // Empty on purpose: Odoo realpaths this option, so /dev/stdout becomes an
      // unopenable /proc/<pid>/fd/pipe:[N] and the log falls back with an ERROR.
      "--logfile=",
    ],
    // Pin the debuggee to the project env (via the profile symlink kept fresh by
    // create-debug-venv). A bare "python" resolves through PATH, and Zed puts the
    // selected toolchain (./.venv, empty) first there.
    "python": "$ZED_WORKTREE_ROOT/.venv/bin/dev-python",
    "cwd": "$ZED_WORKTREE_ROOT",
    "redirectOutput": true,
    "justMyCode": false,
    "env": {
      "PYTHONUNBUFFERED": "1",
    },
  },
]
