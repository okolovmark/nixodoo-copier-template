[project]
name = "{{ project_name }}"
version = "{{ odoo_version }}.0"
description = "Odoo {{ odoo_version }} Development Environment"
readme = "README.md"
requires-python = ">={{ python_version }},<3.{{ (python_version.split('.')[1] | int) + 1 }}"
dependencies = [
    # Populated from src/odoo/requirements.txt by `nix run .#bootstrap-deps`
    # (run `nix run .#update-repos` first to clone src/odoo).

    # Not in Odoo's requirements.txt, and not optional once the project has a
    # browser test. HttpCase.browser_js and start_tour need websocket-client to
    # drive Chrome; without it Odoo SKIPS those tests, and a skip is reported as
    # neither a failure nor an error. The run then reads "0 failed, 0 error(s)"
    # with the browser tests never having executed.
    "websocket-client",

    # Also not in Odoo's requirements.txt, and also not optional. Several OCA
    # modules import it at test-module import time, and Odoo's loader imports
    # EVERY installed module's tests before --test-tags filters them - so a
    # project that aggregates OCA repos cannot run ANY test without it, whatever
    # tags are passed. It has to sit here rather than in the dev extras because
    # flake.nix builds the interpreter from workspace.deps.default.
    "odoo-test-helper",

    # Not in Odoo's requirements.txt either. attachment_indexation reads the text of
    # a PDF attachment through it; without it every PDF is stored with no indexed
    # content, so a content search never finds it, and only a start-up warning says so.
    "pdfminer.six",
{% if odoo_major | int <= 17 %}

    # Odoo {{ odoo_major }}'s odoo/modules/module.py imports pkg_resources, which
    # setuptools 81 removes: with setuptools >= 81 in the env Odoo does not boot.
    # Nothing else holds it back (gevent and zope.* only need some setuptools).
    "setuptools<81",
{% endif %}
]
{% if python_version in ['3.13', '3.14'] %}

[tool.uv]
# Odoo's requirements.txt pins a few C-extension packages at releases that predate
# this interpreter and ship no wheel for it, so the nix build would compile them from
# the sdist — and fail, because the isolated build env has no setuptools. Override
# them to the release the matching Ubuntu (25.10 "Resolute" for 3.14) ships, which
# is the version Odoo itself runs on that interpreter. An override beats the
# imported requirement line and survives `nix run .#bootstrap-deps` re-imports.
override-dependencies = [
    # MarkupSafe 2.1.5 (Odoo's pin for >= 3.12) has no cp313/cp314 wheel; Jinja2 needs only >= 2.0
    "markupsafe==3.0.3 ; python_full_version >= '3.13'",
{% if python_version == '3.14' %}
    # gevent 24.11.1 (Odoo's pin for >= 3.13) has no cp314 wheel
    "gevent==26.8.0 ; python_full_version >= '3.14' and sys_platform != 'win32'",
{% endif %}
]
{% endif %}

[tool.ruff]
line-length = 120
target-version = "py{{ python_version | replace('.', '') }}"
# Lint the project's own scripts and tooling. src/ holds Odoo, the OCA repos (read-only deps) and
# the addons repo, which lints with its own config and hook.
extend-exclude = ["src", ".worktrees"]

[tool.ruff.lint]
select = [
    "BLE",        # flake8-blind-except
    "C",          # flake8-comprehensions
    "COM",        # flake8-commas
    "E",          # pycodestyle Error
    "EM",         # flake8-errmsg
    "EXE",        # flake8-executable
    "F",          # Pyflakes
    "FA",         # flake8-future-annotations
    "FLY",        # flynt
    "G",          # flake8-logging-format
    "I",          # isort
    "ICN",        # flake8-import-conventions
    "INT",        # flake8-gettext
    "ISC",        # flake8-implicit-str-concat
    "LOG",        # flake8-logging
    "PGH",        # pygrep-hooks
    "PIE",        # flake8-pie
    "PLC",        # Pylint Convention
    "PLE",        # Pylint Error
    "PLW",        # Pylint Warning
    "PYI",        # flake8-pyi
    "RET",        # flake8-return
    "RUF",        # Ruff-specific rules
    "SIM",        # flake8-simplify
    "SLOT",       # flake8-slots
    "T",          # flake8-print
    "TC",         # flake8-type-checking
    "TID",        # flake8-tidy-imports
    "TRY",        # tryceratops
    "UP",         # pyupgrade
    "W",          # pycodestyle Warning
    "YTT"         # flake8-2020
    ]
ignore = [
    "C408",       # unnecessary-collection-call
    "C420",       # unnecessary-dict-comprehension-for-iterable
    "C901",       # complex-structure
    "E266",       # multiple-leading-hashes-for-block-comment
    "E501",       # line-too-long
    "E713",       # not-in-test
    "EM102",      # f-string-in-exception
    "FA100",      # future-rewritable-type-annotation
    "PGH003",     # blanket-type-ignore
    "PIE790",     # unnecessary-placeholder
    "PIE808",     # unnecessary-range-start
    "PLC2701",    # import-private-name
    "PLW2901",    # redefined-loop-name
    "RUF001",     # ambiguous-unicode-character-string
    "RUF005",     # collection-literal-concatenation
    "RUF012",     # mutable-class-default
    "RUF100",     # unused-noqa
    "SIM102",     # collapsible-if
    "SIM108",     # if-else-block-instead-of-if-exp
    "SIM117",     # multiple-with-statements
    "TID252",     # relative-imports
    "TRY003",     # raise-vanilla-args
    "TRY300",     # try-consider-else
    "TRY400",     # error-instead-of-exception
    "UP031",      # printf-string-formatting
    ]

[tool.ruff.lint.per-file-ignores]

"**/__init__.py" = [
    "F401",       # unused-import
    "I",          # isort — __init__.py uses one-import-per-line (Odoo convention)
]

"scripts/**" = [
    "T201",       # print — ticket scripts report their dry run on stdout
    "F821",       # undefined-name — `odoo shell` injects `env`
    "EXE001",     # shebang without the executable bit — run through `odoo shell`, not directly
]

# The import groups of the style skill: odoo, then odoo.addons, then this project's modules, and a
# module's own relative imports last (local-folder).
[tool.ruff.lint.isort]
section-order = ["future", "standard-library", "third-party", "odoo", "odoo-addons", {% if module_prefix | default('') %}"{{ module_prefix }}-addons", {% endif %}"first-party", "local-folder"]

[tool.ruff.lint.isort.sections]
"odoo" = ["odoo"]
"odoo-addons" = ["odoo.addons"]
{% if module_prefix | default('') %}
"{{ module_prefix }}-addons" = ["odoo.addons.{{ module_prefix }}_*"]
{% endif %}
