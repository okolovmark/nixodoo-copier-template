// This project's answers to the template: the one file of the mod copier renders.
// Without a Teams status flow in the pipeline skill there is no status gate to wait for.
export const HAS_STATUS_GATE: boolean = {{ 'true' if status_mcp == 'teams' else 'false' }}
// The production web client: a block task's link opens only a record there ('' takes none). The
// Odoo connector returns a _url on odoo_prod_url, so that answer wins over prod_web_url.
export const ODOO_WEB_URL: string = {{ (((odoo_prod_url | default('')).rstrip('/') ~ '/web') if (odoo_prod_url | default('')) else (prod_web_url | default(''))) | tojson }}
// With task_key_route, a task without a record URL opens by its key at project_key's /tasks/<key>.
export const TASK_URL_BASE: string = {{ (((odoo_prod_url | default('')).rstrip('/') ~ '/tasks/') if ((task_key_route | default(false)) and (odoo_prod_url | default(''))) else '') | tojson }}
// A task key is one of the ticket prefixes (ticket_prefix, then extra_ticket_prefixes) and a number:
// any other word-dash-number in a prompt is not a task. None: any word-dash-number is.
export const TICKET_PREFIXES: readonly string[] = {{ ([ticket_prefix | default('')] + (extra_ticket_prefixes | default('') | replace(',', ' ')).split()) | map('trim') | map('upper') | reject('equalto', '') | unique | list | tojson }}
// With use_release_notes, the folder of the addons worktree a task's release note is written to ('' without).
// The release_notes loader skips a note it cannot read, so writing one is no code change: it voids no QC pass.
export const RELEASE_NOTES_DIR: string = {{ (('/' ~ (module_prefix | default('')) ~ '_release_notes/notes/') if (use_release_notes | default(false)) else '') | tojson }}
