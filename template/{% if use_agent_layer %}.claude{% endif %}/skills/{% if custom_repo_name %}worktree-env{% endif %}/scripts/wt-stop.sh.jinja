#!/usr/bin/env bash
# Tear down one session env. A CLEAN worktree (committed + pushed) → remove
# worktree, drop the DB, delete the runtime dir; the branch stays on origin.
# A DIRTY worktree → keep everything (worktree + env + DB) and report, so no
# in-progress work is lost. The env-repo worktree (wt-start --env-repo) counts
# the same way: removed with the env when clean, keeping everything when dirty;
# its branch stays too. Other sessions are unaffected. A wt-start or wt-restore
# building the env, then a wt-test run on it, are waited for first (the env's
# start and test locks, wt-common.sh take_start_lock / take_test_lock).
#
# Usage: wt-stop.sh <slug>
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/wt-common.sh"
# A cwd inside the worktree being removed breaks the later psql DB drop
# (getcwd fails once the dir is gone) while still printing success.
cd "$PROJ"

SLUG="${1:?usage: wt-stop.sh <slug>}"
WT_PATH="$WT_ROOT/$SLUG"
ENVREPO_PATH="$WT_ENVREPO_ROOT/$SLUG"
ENV_DIR="$WT_ENVROOT/$SLUG"

# The start lock, then the test lock, the order every script takes them in. 2 (stale): the env
# was removed while this waited; one re-created since is waited for in turn, both locks again.
LOCK_RC=0 LOCK=start LOCKED=""
while [ -d "$ENV_DIR" ]; do
    for LOCK in start test; do
        LOCK_RC=0
        "take_${LOCK}_lock" "$SLUG" "stopping the env" || LOCK_RC=$?
        [ "$LOCK_RC" -eq 0 ] || break
    done
    [ "$LOCK_RC" -ne 0 ] || LOCKED=1
    [ "$LOCK_RC" -eq 2 ] || break
done
if [ "$LOCK_RC" -eq 2 ]; then
    echo "STATUS: env $SLUG was removed while this waited for its $LOCK lock (another wt-stop?): removing what is left"
elif [ "$LOCK_RC" -ne 0 ] && [ -d "$ENV_DIR" ]; then
    echo "ERROR: cannot take $ENV_DIR/$LOCK.lock: env $SLUG and its service left as they are" >&2
    exit 1
fi
# Read under the locks: a wt-start waited for may have recorded a new name.
DB="$(db_name_for "$SLUG")"

systemctl --user stop "odoo{{ service_suffix }}-wt@$SLUG.service" 2>/dev/null || true

DIRTY=""
for tree in "$WT_PATH" "$ENVREPO_PATH"; do
    if [ -d "$tree" ] && tree_dirty "$tree"; then
        DIRTY="$DIRTY${DIRTY:+ }$tree"
    fi
done
if [ -n "$DIRTY" ]; then
    echo "STATUS: DIRTY-kept ($DIRTY) — uncommitted changes; env + DB $DB preserved"
    exit 0
fi

[ -d "$WT_PATH" ] && git -C "$SRC_REPO" worktree remove "$WT_PATH" 2>/dev/null || true
ENVREPO_NOTE=""
if [ -d "$ENVREPO_PATH" ]; then
    git -C "$PROJ" worktree remove "$ENVREPO_PATH" 2>/dev/null || true
    ENVREPO_NOTE=" + env-repo worktree"
fi
if db_exists "$DB"; then
    drop_db "$DB" 2>/dev/null || true
fi
# A restore killed mid-way leaves its raw staging copy behind.
drop_db "${DB}_restoring" 2>/dev/null || true
# The env's browser sessions (wt-browser.sh) would idle for an hour beside a removed env.
if [ -d "$ENV_DIR/browser" ]; then
    bash "$WT_SCRIPT_DIR/wt-browser.sh" "$SLUG" close-all >/dev/null 2>&1 || true
fi
# Only the env dir this holds the locks of, moved aside in one rename before it is deleted: a
# wt-start meanwhile makes a new one with new locks, never takes these while they go.
if [ -n "$LOCKED" ] && [ -d "$ENV_DIR" ]; then
    GONE="$WT_ENVROOT/.stopping-$SLUG-$$"
    mv "$ENV_DIR" "$GONE"
    rm -rf "$GONE"
fi
echo "STATUS: removed ($SLUG) — worktree$ENVREPO_NOTE + env + DB dropped; branch $SLUG kept"
