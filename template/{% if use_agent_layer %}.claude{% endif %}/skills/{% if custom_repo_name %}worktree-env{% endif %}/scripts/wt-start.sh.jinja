#!/usr/bin/env bash
# Bring up one isolated session env for a task. Safe to run from several
# parallel sessions at once: the worktree-add + port allocation are serialized
# with flock; the slow restore runs outside the lock so sessions overlap.
# Per env, the whole run holds its start lock (a wt-stop of the env waits for it), and
# the service restart its test lock (a wt-test run on the env is waited for).
#
# Usage: [WT_DUMP=<dump>] wt-start.sh <slug> [--env-repo]   # <slug> = branch name, e.g. kio-1234-cash-in-cogs
#   WT_DUMP     restore that dump instead of the newest in backup/ (a new env's DB only;
#               it is named wt_<slug>_<MMDDYY> from the dump's name either way)
#   --env-repo  also check out the project's own repo at .worktrees/_envrepo/<slug> on branch
#               <slug> (off origin's default branch), for the task's ticket scripts, ADRs and
#               skill edits. Later runs, with the flag or without, keep the one that exists.
# Prints WORKTREE / BRANCH / URL / CONF / DB / PORT (+ ENVREPO) for the orchestrator.
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/wt-common.sh"

USAGE="usage: wt-start.sh <slug> [--env-repo]"
SLUG="" WITH_ENVREPO=""
for arg in "$@"; do
    case "$arg" in
        --env-repo) WITH_ENVREPO=1 ;;
        -*) echo "ERROR: unknown option $arg; $USAGE" >&2; exit 2 ;;
        *) [ -z "$SLUG" ] || { echo "ERROR: one slug only; $USAGE" >&2; exit 2; }
           SLUG="$arg" ;;
    esac
done
[ -n "$SLUG" ] || { echo "$USAGE" >&2; exit 2; }
WT_PATH="$WT_ROOT/$SLUG"
ENVREPO_PATH="$WT_ENVREPO_ROOT/$SLUG"
refuse_in_claude_worktree "$WT_PATH"
if [ -n "$WITH_ENVREPO" ] && ! git -C "$PROJ" remote get-url origin >/dev/null 2>&1; then
    echo "ERROR: --env-repo needs $PROJ to be a git checkout with an origin remote" >&2; exit 1
fi
ENV_DIR="$WT_ENVROOT/$SLUG"
DATA_DIR="$ENV_DIR/data"
FARM="$DATA_DIR/addons/{{ odoo_version }}"
CONF="$ENV_DIR/odoo.conf"

bash "$WT_SCRIPT_DIR/wt-bootstrap.sh"
if [ -n "${WT_DUMP:-}" ]; then
    [ -f "$WT_DUMP" ] || { echo "ERROR: WT_DUMP=$WT_DUMP: no such dump" >&2; exit 1; }
    # Recorded for wt-restore, which may run from another cwd: made absolute, its file name
    # kept as given (a link's own name, as the dump's day is read from the name).
    WT_DUMP="$(CDPATH='' cd -- "$(dirname -- "$WT_DUMP")" && pwd)/$(basename -- "$WT_DUMP")"
fi
[ -n "${WT_DUMP:-}" ] || ls "$BACKUP_DIR"/*.dump >/dev/null 2>&1 || {
    echo "ERROR: no prod seed dump in $BACKUP_DIR — {% if backup_s3_bucket %}run \`nix run .#download-backup\`{% else %}put a prod dump into backup/{% endif %}, then retry" >&2; exit 1; }

# 2 (stale): a wt-stop removed the env while this waited; it is made again.
LOCK_RC=2
while [ "$LOCK_RC" -eq 2 ]; do
    mkdir -p "$ENV_DIR" "$DATA_DIR/sessions" "$DATA_DIR/filestore"
    LOCK_RC=0
    take_start_lock "$SLUG" "starting the env" || LOCK_RC=$?
done
[ "$LOCK_RC" -eq 0 ] || { echo "ERROR: cannot take $ENV_DIR/start.lock: env $SLUG left as it is" >&2; exit 1; }

# A DB this env already has (the recorded name, or an older env's undated wt_<slug>) is kept.
# A new one is named after its dump, and the dump is recorded for wt-restore to take.
DB="$(db_name_for "$SLUG")"
if ! db_exists "$DB"; then
    DUMP="$(seed_dump)"
    DB="$(dated_db_name "$SLUG" "$DUMP")"
    echo "$DUMP" > "$ENV_DIR/dump"
fi
echo "$DB" > "$ENV_DIR/db"
HOST="$(session_host "$DB")"

# --- critical section: worktree add + port allocation (serialized) ---
exec 9>"$LOCKFILE"
flock 9
git -C "$SRC_REPO" fetch -q origin {{ odoo_version }}
if git -C "$SRC_REPO" worktree list --porcelain | grep -qx "worktree $WT_PATH"; then
    :                                                                       # reuse
elif git -C "$SRC_REPO" show-ref --verify -q "refs/heads/$SLUG"; then
    git -C "$SRC_REPO" worktree add -q "$WT_PATH" "$SLUG"                    # branch exists
else
    git -C "$SRC_REPO" worktree add -q -b "$SLUG" "$WT_PATH" origin/{{ odoo_version }}
fi
if [ -n "$WITH_ENVREPO" ]; then
    git -C "$PROJ" fetch -q origin
    if git -C "$PROJ" worktree list --porcelain | grep -qx "worktree $ENVREPO_PATH"; then
        :                                                                   # reuse
    elif git -C "$PROJ" show-ref --verify -q "refs/heads/$SLUG"; then
        git -C "$PROJ" worktree add -q "$ENVREPO_PATH" "$SLUG"              # branch exists
    else
        # origin/HEAD is what a clone sets; a repo whose origin was added later has none
        BASE_REF="$(git -C "$PROJ" symbolic-ref -q --short refs/remotes/origin/HEAD || echo origin/main)"
        git -C "$PROJ" worktree add -q -b "$SLUG" "$ENVREPO_PATH" "$BASE_REF"
    fi
fi
if [ -f "$ENV_DIR/port" ]; then
    PORT="$(cat "$ENV_DIR/port")"
else
    USED="$( { cat "$WT_ENVROOT"/*/port 2>/dev/null; \
               ss -H -ltn 2>/dev/null | awk '{print $4}' | sed 's/.*://'; } | sort -u )"
    PORT=""
    for p in $(seq "$PORT_BASE" "$PORT_MAX"); do
        grep -qx "$p" <<<"$USED" || { PORT="$p"; break; }
    done
    [ -n "$PORT" ] || { echo "ERROR: no free port in [$PORT_BASE,$PORT_MAX]" >&2; exit 1; }
    echo "$PORT" > "$ENV_DIR/port"
fi
flock -u 9

# --- outside the lock (parallel): farm, conf, DB restore, filestore, service ---
# conf is written BEFORE the restore: wt-restore's `odoo neutralize` needs it
# (session data_dir/addons farm resolves the installed modules' neutralize.sql).
bash "$WT_SCRIPT_DIR/wt-link.sh" "$WT_PATH" "$FARM"

is_loopback() {
    [[ "$1" =~ ^(::1|localhost|127\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})$ ]]
}
# Beyond loopback /web/database is open to the LAN, where admin_passwd odoo would back up or
# drop any DB on this postgres: a fresh random master password there, and list_db off (below).
ADMIN_PASSWD=odoo
is_loopback "$WT_HTTP_INTERFACE" || ADMIN_PASSWD="$(head -c 24 /dev/urandom | base64 | tr -d '+/=')"

# It carries both passwords: written 0600 (mktemp) beside the conf and moved over it whole, so
# no reader meets it half-written and a failed write leaves the previous one (list_db line included).
CONF_TMP="$(mktemp "$CONF.XXXXXX")"
trap 'rm -f "$CONF_TMP"' EXIT
cat > "$CONF_TMP" <<EOF
[options]
admin_passwd = $ADMIN_PASSWD
data_dir = $DATA_DIR
logfile = $ENV_DIR/odoo.log
db_host = $WT_DB_HOST
db_name = $DB
db_password = $WT_DB_PASSWORD
db_port = $WT_DB_PORT
db_user = {{ db_user }}
dbfilter = ^%d\$
http_interface = $WT_HTTP_INTERFACE
http_port = $PORT
limit_memory_soft = 4294967296
limit_memory_hard = 5368709120
limit_request = 10000
limit_time_cpu = 1200
limit_time_real = 2400
limit_time_real_cron = -1
{% if odoo_major | int >= 17 %}gevent_port{% else %}longpolling_port{% endif %} = $((PORT + 1000))
max_cron_threads = 0
proxy_mode = False
server_wide_modules = base,web{% if use_queue_job %},queue_job{% endif +%}
workers = 0
{% if use_queue_job %}

[queue_job]
channels = {{ queue_job_channels }}
host = $HOST
port = $PORT
{% endif %}
EOF
# [queue_job] host: the runner calls http://<host>:<port>/queue_job/runjob. Left to
# http_interface it would be ::1, an unbracketed and so invalid URL host; and dbfilter
# ^%d$ finds the session DB only by a Host whose first label is the DB name, which
# $HOST is (locally $DB.localhost, resolving to ::1, where the session listens).
is_loopback "$WT_HTTP_INTERFACE" || sed -i '/^admin_passwd = /a list_db = False' "$CONF_TMP"
mv "$CONF_TMP" "$CONF"

bash "$WT_SCRIPT_DIR/wt-restore.sh" "$SLUG"

# The restart would put the service on the DB beside a wt-test run (a -u above all): one Odoo
# per DB, so a run on the env is waited for. The conf was rewritten without it: a running Odoo
# never reads it again, and the move is atomic.
LOCK_RC=0
take_test_lock "$SLUG" "restarting the session service" || LOCK_RC=$?
[ "$LOCK_RC" -eq 0 ] || { echo "ERROR: cannot take $ENV_DIR/test.lock: $DB ready, service not restarted" >&2; exit 1; }

# Pin the host wkhtmltopdf resolves report assets against. report.url wins over
# web.base.url in ir_actions_report._get_report_url, and the conf's report_url is
# NOT a core option (nothing reads it) — this param is the only thing that keeps
# rendering off THIS env. The host carries the DB name for dbfilter ^%d$, and
# resolves to ::1 — hence http_interface = ::1: loopback only, so a neutralized
# prod copy with admin/admin is never reachable from the LAN. A shared test
# server opts in to the LAN with WT_HTTP_INTERFACE / WT_HOST_SUFFIX (wt-common.sh). Runs on the
# reused-DB path too (wt-restore early-exits there), and before the restart so no
# ormcache holds the old value.
$PSQL -q -d "$DB" -c "INSERT INTO ir_config_parameter (key, value) VALUES ('report.url', 'http://$HOST:$PORT') ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value;" >/dev/null

systemctl --user restart "odoo{{ service_suffix }}-wt@$SLUG.service"

echo "WORKTREE: $WT_PATH"
echo "BRANCH: $SLUG"
echo "URL: http://$HOST:$PORT/web"
echo "CONF: $CONF"
echo "DB: $DB"
echo "PORT: $PORT"
if [ -d "$ENVREPO_PATH" ]; then
    echo "ENVREPO: $ENVREPO_PATH"
fi
