# Addon repos cloned + symlinked by `nix run .#update-repos` (Part 2).
#
# One YAML document per repo owner ('---' between them), each with its own ENV.
# Two entry formats:
#   repo-key:              # tracks branch ENV.ODOO_VERSION
#     - "module_a"         # symlink only these modules ('*' = all)
#   repo-key:              # pinned to an exact commit
#     revision: <full 40-char sha>
#     modules:
#       - "module_a"
#
# Repo URL = its document's ENV.DEFAULT_REPO_PATTERN with '{}' replaced by the repo key.
# A matching SSH deploy key at ~/.ssh/<repo-key> is used automatically.
ENV:
  DEFAULT_REPO_PATTERN: "{{ default_repo_pattern }}"
  ODOO_VERSION: "{{ odoo_version }}"
{% if use_queue_job %}

queue:
  - "queue_job"
  - "queue_job_cron"
{% endif %}
# web:
#   - "web_responsive"
{% if odoo_version in ['16.0', '20.0'] and (use_release_notes or task_software_fields) %}

---
# The modules behind use_release_notes and task_software_fields; the repo has
# branches 16.0 and 20.0 only.
ENV:
  DEFAULT_REPO_PATTERN: "https://github.com/okolovmark/{}.git"
  ODOO_VERSION: "{{ odoo_version }}"

nixodoo-addons:
{% if use_release_notes %}
  - "release_notes"
{% endif %}
{% if task_software_fields %}
  - "project_software"
{% endif %}
{% endif %}
{% if custom_repo_name %}

---
ENV:
  DEFAULT_REPO_PATTERN: "{{ custom_repo_pattern }}"
  ODOO_VERSION: "{{ odoo_version }}"

{{ custom_repo_name }}:
  - "*"
{% endif %}
