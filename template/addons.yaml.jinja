# Addon repos cloned + symlinked by `nix run .#update-repos` (Part 2).
#
# One YAML document per repo owner ('---' between them), each with its own ENV.
# Two entry formats:
#   repo-key:              # tracks branch ENV.ODOO_VERSION
#     - "module_a"         # symlink only these modules ('*' = all)
#   repo-key:              # pinned to an exact commit
#     revision: <full 40-char sha>
#     modules:
#       - "module_a"
#
# Repo URL = its document's ENV.DEFAULT_REPO_PATTERN with '{}' replaced by the repo key.
# A matching SSH deploy key at ~/.ssh/<repo-key> is used automatically.
ENV:
  DEFAULT_REPO_PATTERN: "{{ default_repo_pattern }}"
  ODOO_VERSION: "{{ odoo_version }}"
{% if use_queue_job %}

queue:
  - "queue_job"
  - "queue_job_cron"
{% endif %}
{% if use_timesheet_systray %}

# project_timesheet_systray (use_timesheet_systray) runs this module's timer.
project:
  - "project_timesheet_time_control"
{% endif %}
# web:
#   - "web_responsive"
{% if odoo_version in ['16.0', '20.0'] and (use_release_notes or task_ai_driven) %}

---
# The modules behind use_release_notes, task_ai_driven and the answers built on
# it; the repo has branches 16.0 and 20.0 only.
ENV:
  DEFAULT_REPO_PATTERN: "https://github.com/okolovmark/{}.git"
  ODOO_VERSION: "{{ odoo_version }}"

nixodoo-addons:
{% if use_release_notes %}
  - "release_notes"
{% endif %}
{% if task_ai_driven %}
  - "project_ai_driven"
{% endif %}
{% if use_team_dashboard %}
  - "project_team_dashboard"
  # installs itself where OCA project_timeline is installed too, else stays out
  - "project_team_dashboard_timeline"
{% endif %}
{% if use_support_request %}
  - "project_support_request"
{% endif %}
{% if use_timesheet_systray %}
  - "project_timesheet_systray"
{% endif %}
{% endif %}
{% if custom_repo_name %}

---
ENV:
  DEFAULT_REPO_PATTERN: "{{ custom_repo_pattern }}"
  ODOO_VERSION: "{{ odoo_version }}"

{{ custom_repo_name }}:
  - "*"
{% endif %}
